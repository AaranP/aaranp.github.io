---
import { url } from "../lib/url";
const links = [
  { href: url("/#experience"), label: "Experience" },
  { href: url("/#projects"), label: "Projects" },
  { href: url("/#skills"), label: "Skills" },
  { href: url("/#about"), label: "About" },
];
---

<header class="nav-bar">
  <nav class="container" aria-label="Main">
    <a class="home" href={url("/")} aria-label="Aaran Poon home">
      Aaran Poon<span class="home-dot">.</span>
    </a>
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href}>{l.label}</a>
        </li>
      ))}
    </ul>
    <a
      class="contact-link"
      href={url("/Aaran_Poon_resume_D.pdf")}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Open Aaran Poon résumé PDF in a new tab"
    >
      Resume <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: #f8f7f3eb;
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(18px);
  }
  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 74px;
  }
  .home {
    font-size: 1.06rem;
    font-weight: 750;
    letter-spacing: -0.05em;
    text-decoration: none;
    white-space: nowrap;
  }
  .home-dot {
    color: #8d967f;
  }
  ul {
    display: flex;
    gap: clamp(0.4rem, 2vw, 2rem);
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }
  li a,
  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 550;
    white-space: nowrap;
  }
  li a:hover,
  .contact-link:hover {
    text-decoration: underline;
  }
  .contact-link {
    border: 1px solid #c9cbc3;
    border-radius: 999px;
    padding: 0 1rem;
    gap: 0.5rem;
  }
  @media (max-width: 700px) {
    nav {
      min-height: 64px;
      gap: 0.7rem;
      flex-wrap: wrap;
      padding-block: 0.35rem;
    }
    ul {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.15rem;
    }
    li a {
      font-size: 0.75rem;
      padding: 0.15rem;
    }
    .contact-link {
      margin-left: auto;
      font-size: 0.75rem;
      min-height: 44px;
      padding: 0 0.7rem;
    }
  }
</style>
