<div
  class="glass-shell"
  data-glass-pane
  aria-label="Glass pane illustration"
  role="img"
>
  <div class="glass-fallback" aria-hidden="true"></div>
  <button
    class="motion-toggle"
    type="button"
    hidden
    aria-label="Pause motion"
    title="Pause motion"
    aria-pressed="false"
    data-paused="false"
  ><span class="motion-icon" aria-hidden="true"></span></button>
</div>

<script>
  const shell = document.querySelector<HTMLElement>("[data-glass-pane]");
  if (shell && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries[0]?.isIntersecting) return;
        observer.disconnect();
        import("../lib/glass-renderer")
          .then((m) => m.mountGlass(shell))
          .catch((error) => console.warn("Glass pane enhancement unavailable; using static glass.", error));
      },
      { rootMargin: "150px" },
    );
    observer.observe(shell);
  }
</script>

<style>
  .glass-shell {
    position: relative;
    width: 100%;
    height: 340px;
    display: grid;
    place-items: center;
    overflow: hidden;
    touch-action: pan-y;
  }
  .glass-shell[data-ready] {
    touch-action: none;
    cursor: grab;
  }
  .glass-shell[data-ready]:active {
    cursor: grabbing;
  }
  .glass-fallback {
    width: min(52%, 150px);
    aspect-ratio: 0.72;
    border: 2px solid #dce9efb8;
    border-radius: 8px;
    transform: rotate(6deg) skewY(-2deg);
    background: linear-gradient(
      132deg,
      #ffffff4d 0%,
      #ffffff08 45%,
      #d8e7ed4d 100%
    );
    box-shadow:
      inset 2px 1px 2px #fff,
      inset -3px -2px 5px #7898a650,
      8px 12px 22px #65736b16;
  }
  .glass-shell :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .glass-shell[data-ready] .glass-fallback {
    opacity: 0;
  }
  .motion-toggle {
    position: absolute;
    z-index: 2;
    right: 0.25rem;
    bottom: 0.25rem;
    width: 44px;
    min-height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid #cbd0c8;
    border-radius: 50%;
    background: #f8f7f3ce;
    color: var(--text);
    cursor: pointer;
  }
  .motion-toggle:hover { background: #fff; }
  .motion-icon {
    display: block;
    width: 10px;
    height: 13px;
    border-left: 3px solid currentColor;
    border-right: 3px solid currentColor;
  }
  .motion-toggle[data-paused="true"] .motion-icon {
    width: 0;
    height: 0;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 11px solid currentColor;
    border-right: 0;
    margin-left: 3px;
  }
  .motion-toggle[hidden] {
    display: none;
  }
</style>
