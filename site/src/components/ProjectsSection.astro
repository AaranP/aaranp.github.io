---
import ProjectCard from "./ProjectCard.astro";
import { publicProjects, filterChips } from "../lib/data";

// the ONE client-side island of the site (§2): vanilla JS filter, state in
// the URL hash so a filtered view is shareable (/#projects=power-systems)
const projects = await publicProjects();
const chips = filterChips(projects);
---

<div class="filter" role="group" aria-label="Filter projects by domain">
  <button type="button" class="chip" data-filter="all" aria-pressed="true">
    All
  </button>
  {chips.map((c) => (
    <button
      type="button"
      class="chip"
      data-filter={c.slug}
      aria-pressed="false"
    >
      {c.label}
    </button>
  ))}
</div>

<div class="grid" id="project-grid">
  {projects.map((p) => (
    <ProjectCard project={p} />
  ))}
</div>

<p class="muted empty" id="filter-empty" hidden>
  No projects in this category.
</p>

<script>
  const chips = [
    ...document.querySelectorAll<HTMLButtonElement>(".chip[data-filter]"),
  ];
  const cards = [
    ...document.querySelectorAll<HTMLElement>("#project-grid [data-groups]"),
  ];
  const empty = document.getElementById("filter-empty")!;
  const valid = new Set(chips.map((c) => c.dataset.filter!));

  function apply(filter: string) {
    if (!valid.has(filter)) filter = "all";
    let shown = 0;
    for (const card of cards) {
      const match =
        filter === "all" || card.dataset.groups!.split(" ").includes(filter);
      card.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
    for (const chip of chips) {
      chip.setAttribute("aria-pressed", String(chip.dataset.filter === filter));
    }
  }

  function fromHash() {
    const m = location.hash.match(/^#projects=(.+)$/);
    // a non-filter hash (e.g. #experience from the nav) leaves the filter alone
    if (m) {
      try {
        apply(decodeURIComponent(m[1]!));
      } catch {
        apply("all");
      }
    } else if (!location.hash) apply("all");
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      const f = chip.dataset.filter!;
      // replaceState avoids polluting history and avoids anchor scroll-jumps
      history.replaceState(
        null,
        "",
        `${location.pathname}${location.search}${f === "all" ? "" : `#projects=${f}`}`,
      );
      apply(f);
    });
  }

  addEventListener("hashchange", fromHash);
  fromHash();
</script>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .chip {
    font-family: var(--font-body);
    font-size: 0.9rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      color 150ms ease;
  }

  .chip:hover {
    border-color: var(--accent);
  }

  /* active chip is one of the few sanctioned accent uses */
  .chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .empty {
    margin-top: 1rem;
  }
</style>
