---
import { Picture } from "astro:assets";
import { aboutEntry } from "../lib/data";
import ContactEmail from "./ContactEmail.astro";
import GlassPane from "./GlassPane.astro";
import photo from "../../../profile/photo.png";

const about = await aboutEntry();
const { name, headline, intro, location, links } = about.data;
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="portrait-wrap">
    <Picture
      src={photo}
      formats={["webp"]}
      fallbackFormat="png"
      width={700}
      height={700}
      widths={[420, 700, 1000]}
      sizes="(max-width: 700px) 75vw, 32vw"
      alt={`Portrait of ${name}`}
      loading="eager"
      class="portrait"
    />
  </div>
  <div class="intro">
    <span class="eyebrow">Electrical engineer · {location}</span>
    <h1 id="hero-title">{name}</h1>
    <p class="headline">{headline}</p>
    <p class="intro-copy">{intro}</p>
    <div class="actions">
      <ContactEmail email={links.email} label="Get in touch ↗" />
      <a class="button secondary" href="#projects">
        Explore my work <span aria-hidden="true">↘</span>
      </a>
    </div>
    <div class="social">
      <a href={links.github}>GitHub ↗</a>
      <a href={links.linkedin}>LinkedIn ↗</a>
    </div>
  </div>
  <GlassPane />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(210px, 0.9fr) minmax(310px, 1.3fr) minmax(
        190px,
        0.75fr
      );
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: 5.5rem 6rem;
    min-height: 680px;
  }
  .portrait-wrap {
    width: 100%;
    max-width: 370px;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: #d9ded7;
    box-shadow: 0 24px 50px #24231e18;
  }
  .portrait-wrap :global(picture) {
    display: block;
    height: 100%;
  }
  .portrait-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .intro {
    min-width: 0;
  }
  h1 {
    margin: 0.1em 0 0.27em;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }
  .headline {
    font-size: clamp(1.05rem, 1.8vw, 1.45rem);
    font-weight: 610;
    letter-spacing: -0.025em;
    line-height: 1.35;
  }
  .intro-copy {
    max-width: 31rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.8rem 0;
  }
  .actions :global(a:first-child) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    padding: 0.7rem 1.3rem;
    text-decoration: none;
    font-weight: 600;
    background: var(--text);
    color: #fff;
    line-height: 1.2;
  }
  .actions :global(a:first-child:hover) {
    background: #454740;
  }
  .actions .button {
    gap: 0.5rem;
  }
  .social {
    display: flex;
    gap: 1.4rem;
    font-size: 0.87rem;
    font-weight: 600;
  }
  .social a {
    text-decoration: none;
  }
  .social a:hover {
    text-decoration: underline;
  }
  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: minmax(185px, 0.8fr) minmax(310px, 1.3fr);
      min-height: 0;
    }
    .hero :global(.glass-shell) {
      grid-column: 1 / -1;
      justify-self: center;
      width: min(100%, 420px);
      height: 280px;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 2.5rem 4rem;
    }
    .portrait-wrap {
      max-width: 300px;
      margin-inline: auto;
    }
    .intro {
      text-align: center;
    }
    .intro-copy {
      margin-inline: auto;
    }
    .actions,
    .social {
      justify-content: center;
    }
    .hero :global(.glass-shell) {
      grid-column: auto;
      width: min(100%, 360px);
      height: 280px;
    }
  }
</style>
