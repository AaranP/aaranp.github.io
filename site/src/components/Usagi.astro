  <span class="usagi-hint">Drag to turn <span aria-hidden="true">·</span> Arrow keys</span>
</div>

<script>
  const shell = document.querySelector<HTMLElement>("[data-pixel-usagi]");
  if (shell) {
    const mount = () => import("../lib/pixel-usagi")
      .then(({ mountPixelUsagi }) => mountPixelUsagi(shell))
      .catch((error) => console.warn("Pixel Usagi unavailable.", error));
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries[0]?.isIntersecting) return;
        observer.disconnect();
        mount();
      }, { rootMargin: "150px" });
      observer.observe(shell);
    } else mount();
  }
</script>

<style>
  .usagi-shell {
    position: relative;
    width: 100%;
    height: 360px;
    display: grid;
    place-items: center;
    overflow: hidden;
    touch-action: pan-y;
    outline-offset: 4px;
  }
  .usagi-shell[data-ready] { cursor: grab; touch-action: none; }
  .usagi-shell[data-dragging] { cursor: grabbing; }
  .usagi-fallback {
    width: min(84%, 250px);
    height: calc(100% - 30px);
    filter: drop-shadow(0 12px 10px #7a462038);
  }
  .usagi-shell[data-ready] .usagi-fallback { display: none; }
  .usagi-shell :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
  .usagi-hint {
    position: absolute;
    bottom: 0;
    z-index: 1;
    color: var(--text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    pointer-events: none;
  }
</style>
